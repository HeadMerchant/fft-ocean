@cIncludeDir("sokol")
@link("GL")
@link("X11")
@link("Xi")
@link("Xcursor")
@link("dl")
@link("pthread")
@link("m")
@cDefine("SOKOL_IMPL")
@cDefine("SOKOL_GLCORE")
@cDefine("SOKOL_LOG_IMPL")
sg :: @cImport("sokol/sokol_gfx.h", "sg_")

TextureTarget :: enum(u32) {
	Texture2D = 0x0DE1
}
TextureInternalFormat :: enum(u32) {
	Rgba8 = 0x8058
	Rgba32f = 0x8814
}
TextureFormat :: enum(u32) {
	Rgba = 0x1908
}
TextureDataType :: enum(u32) {
	Float = 0x1406
}
TextureParameter :: enum(u32) {
	MinFilter = 0x2801
	MagFilter = 0x2800
	WrapS = 0x2802
	WrapT = 0x2803
}
TextureFilter :: enum(u32) {
	Nearest = 0x2600
	Linear = 0x2601
}
TextureWrap :: enum(u32) {
	ClampToEdge = 0x812F
}

Texture2d :: struct {
	id: u32
} impl {
	texture2dTarget    :: 0x0DE1
	textureNearest     :: 0x2600
	textureClampToEdge :: 0x812F

	create :: fn(
		levels: s32,
		internalFormat: TextureInternalFormat,
		width: s32,
		height: s32
	) -> Self {
		self: Self
		(fn "glGenTextures"(count: s32, textures: ^Self))(1, ^self)
		self.bind()
		set :: fn "glTexParameteri"(target: TextureTarget, param: TextureParameter, value: s32)
		set(.Texture2D, .MinFilter, Self.textureNearest)
		set(.Texture2D, .MagFilter, Self.textureNearest)
		set(.Texture2D, .WrapS, Self.textureClampToEdge)
		set(.Texture2D, .WrapT, Self.textureClampToEdge)
		(fn "glTexStorage2D"(
			target: TextureTarget,
			levels: s32,
			internalFormat: TextureInternalFormat,
			width: s32,
			height: s32
		))(.Texture2D, levels, internalFormat, width, height)
		Self(0).bind()
		return self
	}

	bind :: fn(self: Self) {
		(fn "glBindTexture"(target: TextureTarget, texture: Self))(.Texture2D, self)
	}


	
}


