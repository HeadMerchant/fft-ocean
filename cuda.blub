@cIncludeDir("/opt/cuda/include")
# @cInclude("cuda_shim.c")
@linkDir("/opt/cuda/lib64")
@link("cuda")
@link("cufft")
@link("cudart")
fmt :: import "fmt.blub"

Error :: enum(s32) {
	Success
	Invalid
	OoM
	NotInitialized
	Deinitialized
	ProfilerDisabled
	ProfilerNotInitialized
	ProfilerAlreadyStarted
	ProfileAlreadyStopped
	StubLibrary = 34
	RequiresNewerDriver = 36
	DeviceUnavailable = 46
	NoDevice = 100
	InvalidDevice
	DeviceNotLicensed
	InvalidImage = 200
	InvalidContext
	ContextAlreadyCurrent
	MapFailed = 205
	UnmapFailed
	ArrayIsMapped
	AlreadyMapped
	NoBinaryForGpu
	AlreadyAcquired
	NotMapped
	NotMappedAsArray
	NotMappedAsPointer
	EccUncorrectable
	UnsupportedLimit
	ContextAlreadyInUse
	PeerAccessUnsupported
	InvalidPtx
	InvalidGraphicsContext
	NvlinkUncorrectable
	JitCompilerNotFound
	IllegalAddress = 700
} impl {
	log :: fn(self: Self) {
		if (self == .Success) {
			return
		}
		println @name self
		print("CUDA error code: ")
		print_s32(@bitCast(self, s32))
		@crash
	}
}

float2 :: struct {
	x: f32
	y: f32
}

fftHandle :: s32

fftType :: enum(s32) {
	R2C = 0x2a
	C2R = 0x2c
	C2C = 0x29
	D2Z = 0x6a
	Z2D = 0x6c
	Z2Z = 0x69
}

fftResult :: enum(s32) {
	Success = 0x0
	InvalidPlan = 0x1
	AllocFailed = 0x2
	InvalidType = 0x3
	InvalidValue = 0x4
	InternalError = 0x5
	ExecFailed = 0x6
	SetupFailed = 0x7
	InvalidSize = 0x8
	UnalignedData = 0x9
	InvalidDevice = 0xB
	NoWorkspace = 0xD
	NotImplemented = 0xE
	NotSupported = 0x10
	MissingDependency = 0x11
	NvRtcFailure = 0x12
	NvJitLinkFailure = 0x13
	NvshmemFailure = 0x14
}

fftResult impl {
	log :: fn(self: Self) {
		println @name self
	}
}


DevicePointer :: struct {
	ptr: u64
} impl {
	readBack :: fn(self: Self, dst: ^void, size: usize) {
		println("Readback")
		(fn "cuMemcpyDtoH_v2"(dst: ^void, src: Self, size: usize) -> Error)(dst, self, size).log()
	}

	zeroBuffer :: fn(self: Self, size: usize) {
		println("Zeroing")
		(fn "cuMemsetD8_v2"(dst: Self, value: u8, count: usize) -> Error)(self, 0, size).log()
	}

	copyToDevice :: fn(self: Self, src: ^void, size: usize) {
		(fn "cuMemcpyHtoD_v2"(dst: Self, src: ^void, size: usize) -> Error)(self, src, size).log()
	}
}

setDevice :: fn "cudaSetDevice"(device: s32) -> Error
plan2d :: fn "cufftPlan2d"(plan: ^fftHandle, cols: s32, rows: s32, type: fftType) -> fftResult
destroyPlan :: fn "cufftDestroy"(plan: fftHandle) -> fftResult
execC2R :: fn "cufftExecC2R"(plan: fftHandle, input: DevicePointer, output: DevicePointer) -> fftResult
execC2C :: fn "cufftExecC2C"(plan: fftHandle, input: DevicePointer, output: DevicePointer, direction: s32) -> fftResult

alloc :: fn(size: usize) -> DevicePointer {
	ptr: DevicePointer
	(fn "cuMemAlloc_v2"(ptr: ^DevicePointer, size: usize) -> Error)(^ptr, size).log()
	return ptr
}

gl :: import "gl.blub"

# TODO: move to graphics resource enum
GlTexture2d :: 0x0DE1
GlTextureRectangle :: 0x84F5
GlTextureCubeMap :: 0x8513
GlTexture3d :: 0x806F
GlTexture2dArray :: 0x8C1A
GlRenderbuffer :: 0x8D41

GraphicsRegisterFlags :: enum(u32) {
	None             = 0
	ReadOnly         = 1
	WriteDiscard     = 2
	SurfaceLoadStore = 4
	TextureGather    = 8
}


Array :: ^opaque

Surface :: struct {
	id: u64
} impl {
	destroy :: fn(self: Self) {
		(fn "cudaDestroySurfaceObject"(surfaceObject: Self) -> Error)(self).log()
	}
}



resourceType :: enum(s32) {
	Array = 0
	MipmappedArray = 1
	Linear = 2
	Pitch2D = 3
}

ResourceDesc :: struct {
	resType: resourceType
	_padding0: u32
	array: Array
	_reserved: [15]u64
	flags: u32
	_padding1: u32
}

GraphicsResource :: struct {
	id: u64
} impl {
	fromTexture :: fn(image: gl.Texture2d, flags: GraphicsRegisterFlags) -> Self {
		register :: fn "cudaGraphicsGLRegisterImage"(
			resource: ^Self,
			image: gl.Texture2d,
			target: u32,
			flags: GraphicsRegisterFlags
		) -> Error
		self: Self
		register(^self, image, GlTexture2d, flags).log()
		return self
	}

	map :: fn(self: ^Self) {
		(fn "cudaGraphicsMapResources"(
			count: s32,
			resources: ^GraphicsResource,
			stream: Stream
		) -> Error)(1, self, null).log()
	}

	mapSurface :: fn(self: Self) -> Surface {
		self.map()

		array : Array
		(fn "cudaGraphicsSubResourceGetMappedArray"(
			array: ^Array,
			resource: GraphicsResource,
			arrayIndex: u32,
			mipLevel: u32
		) -> Error)(^array, self, 0, 0).log()
		surface: Surface
		desc := ResourceDesc(
			resType = .Array,
			array = array,
		)

		(fn "cudaCreateSurfaceObject"(
			surfaceObject: ^Surface,
			resourceDesc: ^ResourceDesc
		) -> Error)(^surface, ^desc).log()

		return surface
	}

	unmap :: fn(self: ^Self) {
		(fn "cudaGraphicsUnmapResources"(
			count: s32,
			resources: ^GraphicsResource,
			stream: Stream
		) -> Error)(1, self, null).log()
	}



	unregister :: fn(self: Self) {
		(fn "cudaGraphicsUnregisterResource"(resource: GraphicsResource) -> Error)(self).log()
	}
}

Device :: s32
Context :: struct {ptr: ^opaque}
Module :: struct {ptr: ^opaque}
Kernel :: struct {ptr: ^opaque}
Symbol :: struct {ptr: ^opaque}

Module impl {
	load :: fn(image: ^u8) -> Self {
		module: Self
		(fn "cuModuleLoadData"(module: ^Module, image: ^u8) -> Error)(^module, image).log()
		return module
	}

	loadKernel :: fn(self: Self, name: ^u8) -> Kernel {
		resultKernel: Kernel
		(fn "cuModuleGetFunction"(
			hfunc: ^Kernel,
			hmod: Module,
			name: ^u8
		) -> Error)(^resultKernel, self, name).log()
		return resultKernel
	}

	getGlobal :: fn(self: Self, name: ^u8) -> DevicePointer {
		ptr: DevicePointer
		toss: usize
		(fn "cuModuleGetGlobal"(
			dptr: ^DevicePointer,
			bytes: ^usize,
			hmod: Module,
			name: ^u8,
		) -> Error)(^ptr, ^toss, self, name).log()
		return ptr
	}
}

Grid :: struct {
	x: u32
	y: u32
	z: u32
} impl {
	of :: fn(size: u32) -> Self {
		return (size, size, size)
	}
}

Block :: struct {
	x: u32
	y: u32
	z: u32
} impl {
	of :: fn(size: u32) -> Self {
		return (size, size, size)
	}
}

Stream :: ^opaque


sync :: fn "cuCtxSynchronize"() -> Error

Kernel impl {
	launch :: fn (self: Self, args: [^]^void, grid: Grid, block: Block, sharedMem: u32) {
		(fn "cuLaunchKernel"(
			f: Kernel,
		    gridDimX: u32,
		    gridDimY: u32,
		    gridDimZ: u32,
		    blockDimX: u32,
		    blockDimY: u32,
		    blockDimZ: u32,
		    sharedMemBytes: u32,
		    hStream: Stream,
		    kernelParams: [^]^void,
		    extra: ^^void
		) -> Error)(
			self,
			grid.x,
			grid.y,
			grid.z,
			block.x,
			block.y,
			block.z,
			sharedMem,
			null,
			args,
			null
		).log()
	}

	launchAndSync :: fn(self: Self, args: [^]^void, grid: Grid, block: Block, sharedMem: u32) {
		println("launch")
		self.launch(args, grid, block, sharedMem)
		println("syncing")
		sync().log()
		println("synced")
	}
}

Device impl {
	init :: fn(self: ^Self, moduleSource: ^u8) -> Module {
		using fmt
		println("Initializing CUDA")
		(fn "cuInit"(flags: u32) -> Error)(0).log()
		println("Initializing CUDA runtime primary context")
		setDevice(0).log()
		# println("Getting CUDA device")
		# (fn "cuDeviceGet"(device: ^Self, ordinal: u32) -> Error)(self, 0).log()
		context : Context
		println("Getting CUDA current context")
		(fn "cuCtxGetCurrent"(context: ^Context) -> Error)(^context).log()
		println("Loading CUDA module")
		return Module.load(moduleSource)
	}
}
