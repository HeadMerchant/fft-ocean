@cIncludeDir("/opt/cuda/include")
@linkDir("/opt/cuda/lib64")
@link("cuda")
@link("cufft")
@link("cudart")
fmt :: import "fmt.blub"

Error :: enum(s32) {
	Success
	Invalid
	OoM
	NotInitialized
	Deinitialized
	ProfilerDisabled
	ProfilerNotInitialized
	ProfilerAlreadyStarted
	ProfileAlreadyStopped
	StubLibrary = 34
	RequiresNewerDriver = 36
	DeviceUnavailable = 46
	NoDevice = 100
	InvalidDevice
	DeviceNotLicensed
	InvalidImage = 200
	InvalidContext
	ContextAlreadyCurrent
	MapFailed = 205
	UnmapFailed
	ArrayIsMapped
	AlreadyMapped
	NoBinaryForGpu
	AlreadyAcquired
	NotMapped
	NotMappedAsArray
	NotMappedAsPointer
	EccUncorrectable
	UnsupportedLimit
	ContextAlreadyInUse
	PeerAccessUnsupported
	InvalidPtx
	InvalidGraphicsContext
	NvlinkUncorrectable
	JitCompilerNotFound
} impl {
	log :: fn(self: Self) {
		if (self == .Success) {
			println("Success")
			return
		}
		print("CUDA error code: ")
		print_s32(@bitCast(self, s32))
		println("")
		@crash()
	}
}

float2 :: struct {
	x: f32
	y: f32
}

fftHandle :: s32

fftType :: enum(s32) {
	R2C = 0x2a
	C2R = 0x2c
	C2C = 0x29
	D2Z = 0x6a
	Z2D = 0x6c
	Z2Z = 0x69
}

fftResult :: enum(s32) {
	Success = 0x0
	InvalidPlan = 0x1
	AllocFailed = 0x2
	InvalidType = 0x3
	InvalidValue = 0x4
	InternalError = 0x5
	ExecFailed = 0x6
	SetupFailed = 0x7
	InvalidSize = 0x8
	UnalignedData = 0x9
	InvalidDevice = 0xB
	NoWorkspace = 0xD
	NotImplemented = 0xE
	NotSupported = 0x10
	MissingDependency = 0x11
	NvRtcFailure = 0x12
	NvJitLinkFailure = 0x13
	NvshmemFailure = 0x14
}

fftResult impl {
	log :: fn(self: Self) {
		println @name self
	}
}

setDevice :: fn "cudaSetDevice"(device: s32) -> Error
plan2d :: fn "cufftPlan2d"(plan: ^fftHandle, cols: s32, rows: s32, type: fftType) -> fftResult
destroyPlan :: fn "cufftDestroy"(plan: fftHandle) -> fftResult
execC2R :: fn "cufftExecC2R"(plan: fftHandle, input: ^void, output: ^void) -> fftResult
execC2C :: fn "cufftExecC2C"(plan: fftHandle, input: ^void, output: ^void, direction: s32) -> fftResult

memcpyKind :: enum(s32) {
	HostToHost
	HostToDevice
	DeviceToHost
	DeviceToDevice
	Default
}

DevicePointer :: u64
memAlloc :: fn "cuMemAlloc_v2"(ptr: ^DevicePointer, size: usize) -> Error
memcpyHtoD :: fn "cuMemcpyHtoD_v2"(dst: DevicePointer, src: ^void, size: usize) -> Error
memcpyDtoH :: fn "cuMemcpyDtoH_v2"(dst: ^void, src: DevicePointer, size: usize) -> Error
memsetD8 :: fn "cuMemsetD8_v2"(dst: DevicePointer, value: u8, count: usize) -> Error
GraphicsResource :: ^opaque
Array :: ^opaque
SurfaceObject :: u64
resourceType :: enum(s32) {
	Array = 0
	MipmappedArray = 1
	Linear = 2
	Pitch2D = 3
}
graphicsRegisterFlags :: enum(u32) {
	None = 0
	ReadOnly = 1
	WriteDiscard = 2
	SurfaceLoadStore = 4
}
ResourceDesc :: struct {
	resType: resourceType
	_padding0: u32
	array: Array
	_reserved: [15]u64
	flags: u32
	_padding1: u32
}
Device :: s32
Context :: struct {ptr: ^opaque}
Module :: struct {ptr: ^opaque}
Kernel :: struct {ptr: ^opaque}

init :: fn "cuInit"(flags: u32) -> Error
deviceGet :: fn "cuDeviceGet"(device: ^Device, ordinal: u32) -> Error
ctxGetCurrent :: fn "cuCtxGetCurrent"(ctx: ^Context) -> Error

loadModule :: fn "cuModuleLoadData"(module: ^Module, image: ^void) -> Error
getFunction :: fn "cuModuleGetFunction"(
	hfunc: ^Kernel,
	hmod: Module,
	name: ^u8
) -> Error

Module impl {
	loadKernel :: fn(self: Self, name: ^u8) -> Kernel {
		resultKernel: Kernel
		getFunction(^resultKernel, self, name).log()
		return resultKernel
	}
}

Grid :: struct {
	x: u32
	y: u32
	z: u32
} impl {
	of :: fn(size: u32) -> Self {
		return (size, size, size)
	}
}

Block :: struct {
	x: u32
	y: u32
	z: u32
} impl {
	of :: fn(size: u32) -> Self {
		return (size, size, size)
	}
}

Stream :: ^opaque

launchKernel :: fn "cuLaunchKernel"(
	f: Kernel,
    gridDimX: u32,
    gridDimY: u32,
    gridDimZ: u32,
    blockDimX: u32,
    blockDimY: u32,
    blockDimZ: u32,
    sharedMemBytes: u32,
    hStream: Stream,
    kernelParams: [^]^void,
    extra: ^^void,
) -> Error

sync :: fn "cuCtxSynchronize"() -> Error
graphicsGLRegisterImage :: fn "cudaGraphicsGLRegisterImage"(
	resource: ^GraphicsResource,
	image: u32,
	target: u32,
	flags: u32
) -> Error
graphicsMapResources :: fn "cudaGraphicsMapResources"(
	count: s32,
	resources: ^GraphicsResource,
	stream: Stream
) -> Error
graphicsUnmapResources :: fn "cudaGraphicsUnmapResources"(
	count: s32,
	resources: ^GraphicsResource,
	stream: Stream
) -> Error
graphicsSubResourceGetMappedArray :: fn "cudaGraphicsSubResourceGetMappedArray"(
	array: ^Array,
	resource: GraphicsResource,
	arrayIndex: u32,
	mipLevel: u32
) -> Error
graphicsUnregisterResource :: fn "cudaGraphicsUnregisterResource"(resource: GraphicsResource) -> Error
createSurfaceObject :: fn "cudaCreateSurfaceObject"(
	surfaceObject: ^SurfaceObject,
	resourceDesc: ^ResourceDesc
) -> Error
destroySurfaceObject :: fn "cudaDestroySurfaceObject"(surfaceObject: SurfaceObject) -> Error
Kernel impl {
	launch :: fn (self: Self, args: [^]^void, grid: Grid, block: Block, sharedMem: u32) {
		launchKernel(
			self,
			grid.x,
			grid.y,
			grid.z,
			block.x,
			block.y,
			block.z,
			sharedMem,
			null,
			args,
			null
		).log()
	}

	launchAndSync :: fn(self: Self, args: [^]^void, grid: Grid, block: Block, sharedMem: u32) {
		self.launch(args, grid, block, sharedMem)
		sync().log()
	}
}

Device impl {
	init :: fn(self: ^Self, moduleName: ^u8) -> Module {
		using fmt
		println("Initializing CUDA")
		init(0).log()
		println("Initializing CUDA runtime primary context")
		setDevice(0).log()
		println("Getting CUDA device")
		deviceGet(self, 0).log()
		context : Context
		println("Getting CUDA current context")
		ctxGetCurrent(^context).log()
		module : Module
		println("Loading CUDA module")
		loadModule(^module, moduleName).log()
		return module
	}
}
