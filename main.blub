cu :: import "cuda.blub"
gl :: import "gl.blub"
sg :: gl.sg
ui :: import "ui.blub"

using import "math.blub"

app :: @cImport("sokol/sokol_app.h", "sapp_")
time :: @cImport("sokol/sokol_time.h", "stm_")
log :: @cImport("sokol/sokol_log.h", "slog_")

@cInclude("sokol/sokol_glue.h")
glueEnv :: fn "sglue_environment"() -> sg.environment
swapchain :: fn "sglue_swapchain"() -> sg.swapchain
using import "fmt.blub"
kernels :: @cudaImport "tessendorf_ocean.cu.blub"

OceanResolution :: kernels.Size
OceanBlockSize :: 8

CudaTexture :: struct {
	texture: gl.Texture2d
	resource: cu.GraphicsResource
} impl {
	create :: fn() -> Self {
		# TODO: initialize multiple at once?
		texture := gl.Texture2d.create(1, .Rg32f, OceanResolution, OceanResolution)
		return (texture = texture, resource = cu.GraphicsResource.fromTexture(texture, .SurfaceLoadStore))
	}
	# destroy :: fn(self: ^Self) {
	# 	self.resource.unregister()
	# 	self.texture.destroy()
	# }
}

OceanCudaState :: struct {
	device: cu.Device
	module: cu.Module
	initializeSpectrum: cu.Kernel
	updateSpectrum: cu.Kernel
	horizontalFft: cu.Kernel
	verticalFft: cu.Kernel
	assembleMaps: cu.Kernel
	params: kernels.OceanParams
	initial: CudaTexture
	horizontalDisplacement: CudaTexture
	spectrumB: CudaTexture
	spectrumC: CudaTexture
	spectrumD: CudaTexture
	displacement: CudaTexture
	heightFoam: CudaTexture
	slope: CudaTexture
	initialized: bool
}

ocean : OceanCudaState

Surfaces :: struct {
	initial: cu.Surface
	horizontalDisplacement: cu.Surface
	spectrumB: cu.Surface
	spectrumC: cu.Surface
	spectrumD: cu.Surface
	displacement: cu.Surface
	heightFoam: cu.Surface
	slope: cu.Surface
} impl {
	map :: fn() -> Self {
		return (
			initial = ocean.initial.resource.mapSurface(),
			horizontalDisplacement = ocean.horizontalDisplacement.resource.mapSurface(),
			spectrumB = ocean.spectrumB.resource.mapSurface(),
			spectrumC = ocean.spectrumC.resource.mapSurface(),
			spectrumD = ocean.spectrumD.resource.mapSurface(),
			displacement = ocean.displacement.resource.mapSurface(),
			heightFoam = ocean.heightFoam.resource.mapSurface(),
			slope = ocean.slope.resource.mapSurface(),
		)
	}

	unmap :: fn(self: ^Self) {
		self.initial.destroy()
		self.horizontalDisplacement.destroy()
		self.spectrumB.destroy()
		self.spectrumC.destroy()
		self.spectrumD.destroy()
		self.displacement.destroy()
		self.heightFoam.destroy()
		self.slope.destroy()
		ocean.initial.resource.unmap()
		ocean.horizontalDisplacement.resource.unmap()
		ocean.spectrumB.resource.unmap()
		ocean.spectrumC.resource.unmap()
		ocean.spectrumD.resource.unmap()
		ocean.displacement.resource.unmap()
		ocean.heightFoam.resource.unmap()
		ocean.slope.resource.unmap()
	}
}

startupFrameLogged := false

startupLog :: fn(message: []u8) {
	print("[startup] ")
	println(message)
}

startupValue :: fn(label: []u8, value: s32) {
	print("[startup] ")
	print(label)
	print(": ")
	print_s32(value)
	println("")
}

oceanGrid :: fn() -> cu.Grid {
	return (
		OceanResolution / OceanBlockSize,
		OceanResolution / OceanBlockSize,
		1,
	)
}

oceanBlock :: fn() -> cu.Block {
	return (OceanBlockSize, OceanBlockSize, 1)
}

setupOceanTextures :: fn() {
	ocean.initial = CudaTexture.create()
	ocean.horizontalDisplacement = CudaTexture.create()
	ocean.spectrumB = CudaTexture.create()
	ocean.spectrumC = CudaTexture.create()
	ocean.spectrumD = CudaTexture.create()
	ocean.displacement = CudaTexture.create()
	ocean.heightFoam = CudaTexture.create()
	ocean.slope = CudaTexture.create()
	sg.reset_state_cache()
	imageDesc := sg.image_desc(
		usage = (immutable = true),
		width = OceanResolution,
		height = OceanResolution,
		num_slices = 1,
		num_mipmaps = 1,
		pixel_format = .RG32F,
		sample_count = 1,
		gl_textures = [ocean.heightFoam.texture.id, 0],
		gl_texture_target = cu.GlTexture2d,
		label = c"ocean-image"
	)
	state.oceanImage = sg.make_image(^imageDesc)
	print("Ocean image state: ")
	sg.query_image_state(state.oceanImage).print()
	println("")
	viewDesc := sg.view_desc(texture = (image = state.oceanImage), label = c"ocean-view")
	println("Make view")
	state.oceanView = sg.make_view(^viewDesc)
	print("Ocean view state: ")
	sg.query_view_state(state.oceanView).print()
	println("")
	println("Make sampler")
	samplerDesc := sg.sampler_desc(
		min_filter = .NEAREST,
		mag_filter = .NEAREST,
		mipmap_filter = .NEAREST,
		label = c"ocean-sampler"
	)
	state.oceanSampler = sg.make_sampler(^samplerDesc)
	state.bind.views[0] = state.oceanView
	state.bind.samplers[0] = state.oceanSampler

}

setupOceanCuda :: fn() {
	if (ocean.initialized) {
		startupLog("cuda setup skipped")
		return
	}

	startupLog("cuda setup begin")
	ocean.params = kernels.OceanParams(
		resolution = @numCast(OceanResolution, u32),
		lengthScale = 256,
		frameTime = 0,
		deltaTime = 0,
		repeatTime = 200,
		depth = 200,
		lowCutoff = 0.001,
		highCutoff = 1000,
		seed = 1,
		jonswap = (
			scale = 1,
			angle = 0,
			spreadBlend = 0.7,
			swell = 0.5,
			alpha = 0.0081,
			peakOmega = 0.8,
			gamma = 3.3,
			shortWavesFade = 0.08,
		),
		lambda = (1.25, 1.25),
		foamBias = 1,
		foamDecayRate = 0.02,
		foamAdd = 0.5,
		foamThreshold = 0.1,
	)
	startupLog("cuda params ready")

	startupLog("cuda module init")
	module := ocean.device.init(@cudaPtx kernels)
	ocean.module = module
	startupLog("cuda module loaded")
	startupLog("load kernel initializeSpectrum")
	ocean.initializeSpectrum = module.loadKernel(kernels.initializeSpectrum)
	ocean.updateSpectrum = module.loadKernel(kernels.updateSpectrum)
	ocean.horizontalFft = module.loadKernel(kernels.horizontalFft)
	ocean.verticalFft = module.loadKernel(kernels.verticalFft)
	ocean.assembleMaps = module.loadKernel(kernels.assembleMaps)
	startupLog("cuda kernels loaded")
	startupLog("launch initializeSpectrum")
	surfaces := Surfaces.map()
	args := [
		^ocean.params,
		^surfaces.initial,
		# ^surfaces.displacement,
		# ^surfaces.heightFoam,
		# ^surfaces.slope,
	]^void
	ocean.initializeSpectrum.launch(args[^], oceanGrid(), oceanBlock(), 0)
	cu.sync().log()
	surfaces.unmap()
	ocean.initialized = true
	startupLog("cuda setup complete")
}

updateOcean :: fn(frameTime: f32, dt: f32) {
	ocean.params.frameTime = frameTime
	ocean.params.deltaTime = dt
	surfaces := Surfaces.map()
	# TODO: constant memory
	updateArgs := [
		^ocean.params,
		^surfaces.initial,
		^surfaces.horizontalDisplacement,
		^surfaces.spectrumB,
		^surfaces.spectrumC,
		^surfaces.spectrumD,
	]^void
	ocean.updateSpectrum.launch(updateArgs[^], oceanGrid(), oceanBlock(), 0)
	fftArgs := [
		^surfaces.horizontalDisplacement,
		^surfaces.spectrumB,
		^surfaces.spectrumC,
		^surfaces.spectrumD,
	]^void
	ocean.horizontalFft.launch(fftArgs[^], (1, OceanResolution, 1), (OceanResolution, 1, 1), 0)
	ocean.verticalFft.launch(fftArgs[^], (OceanResolution, 1, 1), (OceanResolution, 1, 1), 0)
	assembleArgs := [
		^ocean.params,
		^surfaces.horizontalDisplacement,
		^surfaces.spectrumB,
		^surfaces.spectrumC,
		^surfaces.spectrumD,
		^surfaces.displacement,
		^surfaces.heightFoam,
		^surfaces.slope,
	]^void
	ocean.assembleMaps.launch(assembleArgs[^], oceanGrid(), oceanBlock(), 0)
	cu.sync().log()
	surfaces.unmap()
}

sg.resource_state impl {
	print :: fn(self: Self) {
		print(@name self)
	}
}

state : struct {
    pip: sg.pipeline
    bind: sg.bindings
    passAction: sg.pass_action
	oceanImage: sg.image
	oceanView: sg.view
	oceanSampler: sg.sampler
	testTexture: gl.Texture2d
	position: vec3
	latitude: f32
	longitude: f32
} = (position = (0, 0, 0.5))

Input :: struct {
	mousePos: vec2
	mouseDown: bool
	forward: bool
	backward: bool
	left: bool
	right: bool
	up: bool
	down: bool
	mouseDelta: vec2
} impl {
	press :: fn(self: ^Self, keycode: app.keycode, pressed: bool) {
		when (keycode) {
			.W -> input.forward
			.A -> input.left
			.S -> input.backward
			.D -> input.right
			.SPACE -> input.up
			.LEFT_SHIFT -> input.down
			.RIGHT_SHIFT -> input.down
			else -> return
		} = pressed
	}
}
input := Input()

cleanup :: fn() {
	sg.shutdown()
}

vs := "
#version 410
uniform vec4 mvp[4];

layout(location = 0) in vec2 position;
layout(location = 0) out vec2 uv;
void main() {
    vec4 pos = vec4(2. * position - 1., 0., 1.);
    gl_Position = mat4(mvp[0], mvp[1], mvp[2], mvp[3]) * pos;
    uv = position;
}\x00"

fs := "
#version 410
uniform sampler2D ocean_tex;
layout(location = 0) out vec4 frag_color;
layout(location = 0) in vec2 uv;
void main() {
    vec2 ocean = texture(ocean_tex, uv).rg;
    float height = ocean.r;
    float foam = ocean.g;
	// frag_color = vec4(vec3(height * 6.0 + 0.5 + foam), 1.0);
	frag_color = vec4(height, foam, 0.0, 1.0);
}\x00"

startTime : u64 = 0

PlaneRes :: 4
PlaneFence :: PlaneRes - 1
indexLength :: 6 (PlaneFence ** 2)

init :: fn() {
	startupLog("init begin")
	desc := sg.desc(
	environment = glueEnv(),
	logger = (func = log.func)
	)
	startupLog("calling sg.setup")
	sg.setup(^desc)
	startupLog("sg.setup complete")

	# R R+1
	#  \
	# 0 1
	vertIndex :: fn(x: u32, y: u32) -> u32 {
		return x PlaneRes + y
	}

	using import "memory.blub"
	# mesh : ^MeshData = malloc @sizeOf MeshData
	# verts := ^mesh.verts
	# indices := ^mesh.indices
	Verts :: [PlaneRes ** 2]vec2
	verts : ^Verts = malloc @sizeOf Verts
	Indices :: [indexLength]u32
	indices : ^Indices = malloc @sizeOf Indices
	for (x: u32 = 0..<PlaneRes) for (y: u32 = 0..<PlaneRes) {
		i := (x PlaneRes) + y
		verts^[i] = (@numCast(x, f32) / PlaneFence, @numCast(y, f32) / PlaneFence)
		printFloat(verts^[i].x)
		print(", ")
		printFloat(verts^[i].y)
		println("")
	}
	println "finished verts"

	print_u32 6 PlaneFence ** 2
	println " tris indices"
	for (x: u32 = 0 ..< PlaneFence) for (y: u32 = 0 ..< PlaneFence) {
	  triIndex := 6 ((x PlaneFence) + y)
	  vert := vertIndex(x, y)
	  print("Tri index: ")
	  print_u32(triIndex)
	  print("\nVert index: ")
	  print_u32 vert
	  println("")

	  indices^[triIndex]     = vert + PlaneRes
	  indices^[triIndex + 1] = vert
	  indices^[triIndex + 2] = vert + 1

	  indices^[triIndex + 3] = vert + PlaneRes
	  indices^[triIndex + 4] = vert + 1
	  indices^[triIndex + 5] = vert + PlaneRes + 1
	}
	println "finished geometry init"
	for (x := indices^[]) {
		print_u32(x)
		println ""
	}

	println("verts")
	i := 0
	for (v := verts^[]) {
		v.print()
	}


	vertBufferDesc := sg.buffer_desc(
		data = sg.range(verts, @sizeOf @type verts),
		label = c"vertex-buf",
	)

	indexBufferDesc := sg.buffer_desc(
		data = sg.range(indices, @sizeOf @type indices),
		usage = (index_buffer = true),
		label = c"index-buf",
	)

	vertBuffer := sg.make_buffer(^vertBufferDesc)
	indexBuffer := sg.make_buffer(^indexBufferDesc)
	startupLog("buffers created")
	state.bind.vertex_buffers[0] = vertBuffer
	print("Vertex buffer state: ")
	sg.query_buffer_state(vertBuffer).print()
	println("")

	state.bind.index_buffer = indexBuffer

	shader := sg.shader_desc(
		vertex_func = (
			source = ^vs.data[0],
			entry = c"main",
		),
		fragment_func = (
			source = ^fs.data[0],
			entry = c"main",
		),
		label = c"triangle_shader"
	)
	shader.attrs[0] = (
		base_type = .FLOAT,
		glsl_name = c"position"
	)
	shader.views[0].texture = (
		stage = .FRAGMENT,
		sample_type = .UNFILTERABLE_FLOAT,
	)
	shader.samplers[0] = (
		stage = .FRAGMENT,
		sampler_type = .NONFILTERING,
	)
	shader.texture_sampler_pairs[0] = (
		stage = .FRAGMENT,
		view_slot = 0,
		sampler_slot = 0,
		glsl_name = c"ocean_tex"
	)
	shader.uniform_blocks[0] = (
	    stage = .VERTEX,
	    size = @sizeOf mat4,
	)
	shader.uniform_blocks[0].glsl_uniforms[0] = (
	    type = .FLOAT4,
	    array_count = 4,
	    glsl_name = c"mvp"
	)

	println("Making shader")
	fullShader := sg.make_shader(^shader)
	println("Made shader")

	pipelineDesc := sg.pipeline_desc(
		shader = fullShader,
		cull_mode = .BACK,
		depth = (
			write_enabled = true,
			compare = .LESS_EQUAL,
		),
		index_type = .UINT32,
	)
	print("Shader creation: ")
	sg.query_shader_state(pipelineDesc.shader).print()
	println("")

	pipelineDesc.layout.attrs[0].format = .FLOAT2

	startupLog("creating pipeline")
	state.pip = sg.make_pipeline(^pipelineDesc)
	if (state.pip.id == 0) {
		print("Failed to make pipeline")
	} else {
		print("Made pipeline")
	}
	println("")

	state.passAction.colors[0] = (
		load_action = .CLEAR,
		clear_value = (0, 0, 0, 1)
	)

	startupLog("creating ocean texture")
	setupOceanTextures()
	startupLog("starting cuda setup")
	setupOceanCuda()
	startupLog("starting time setup")
	time.setup()
	startTime = time.now()
	startupLog("init complete")

	free verts
	free indices
}

prevTime := 0.
deltaTime := 0.

frame :: fn() {
	if (!startupFrameLogged) {
		startupLog("first frame begin")
	}
	seconds : f32 = @numCast(time.sec(time.since(startTime)))
	deltaTime = seconds - prevTime
	movement := vec3(
		if (input.left) -1 else if (input.right) 1 else 0,
		if (input.up) 1 else if (input.down) -1 else 0,
		if (input.backward) 1 else if (input.forward) -1 else 0
	)

	updateOcean(seconds, deltaTime)
	if (!startupFrameLogged) {
		startupLog("first frame cuda launches complete")
		startupFrameLogged = true
	}

	# colors
	red := sin(2 seconds)
	state.passAction.colors[0].clear_value.r = red red

	# rendering
	pass := sg.pass(action = state.passAction, swapchain = swapchain())
	sg.begin_pass(^pass)
    sg.apply_pipeline(state.pip)
    sg.apply_bindings(^state.bind)


	# camera
	w := app.widthf()
	h := app.heightf()
	aspect := w/h
	rotation := quat.geographic(state.latitude, state.longitude)
	rotMat := rotation.toMatrix()
	translationAmount := RotateV3Q(movement, rotation.inverse())
	# translationAmount.print()
	translationAmount = MulV3F(translationAmount, deltaTime)

	state.position = AddV3(state.position, translationAmount)

	proj := Perspective(1. / 6., aspect, 0.01, 100)

	camera := Translate(MulV3F(state.position, -1))

	mvp := proj rotMat camera

	uniformRange := sg.range(^mvp, @sizeOf @type(mvp))
	sg.apply_uniforms(0, ^uniformRange)

  sg.draw(0, indexLength, 1)
  sg.end_pass()
  sg.commit()

	prevTime = seconds
}

event :: fn(e: ^app.event) {
	when (e.type) {
		.MOUSE_DOWN -> {
			println("mouse down")
			input.mouseDown = true
		}
		.MOUSE_UP -> {
			println("mouse up")
			input.mouseDown = false
		}
		.KEY_DOWN -> input.press(e.key_code, true)
		.KEY_UP -> input.press(e.key_code, false)
		.MOUSE_MOVE -> if (input.mouseDown) {
			dt := deltaTime * .2
			state.latitude += e.mouse_dx * dt
			state.longitude += e.mouse_dy * dt
		}
	}
}

sokol_main :: fn(argc: s32, argv: [^][^]u8) -> app.desc {
	return (
		init_cb = init,
		frame_cb = frame,
		cleanup_cb = cleanup,
		event_cb = event,
		width = 640,
		height = 480,
		window_title = c"Triangle",
	)
}
