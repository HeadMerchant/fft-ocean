cu :: import "cuda.blub"
sokol :: import "sokol.blub"
sg :: sokol.gfx
gl :: import "gl.blub"
app :: sokol.app
time :: sokol.time
microui :: import "ui.blub"
using import "math.blub"
using import "fmt.blub"
kernels :: @cudaImport "tessendorf_ocean.cu.blub"

OceanResolution :: kernels.Size
OceanBlockSize :: 8

CudaTexture :: struct {
	texture: gl.Texture2d
	resource: cu.GraphicsResource
}

CudaTextureMethods :: CudaTexture impl {
	create :: fn() -> Self {
		# TODO: initialize multiple at once?
		texture := gl.Texture2dMethods.create(1, .Rg32f, OceanResolution, OceanResolution, false)
		return (
			texture = texture,
			resource = cu.GraphicsResourceMethods.fromTexture(texture, .SurfaceLoadStore)
		)
	}

	createRgba :: fn() -> Self {
		texture := gl.Texture2dMethods.create(1, .Rgba32f, OceanResolution, OceanResolution, false)
		return (
			texture = texture,
			resource = cu.GraphicsResourceMethods.fromTexture(texture, .SurfaceLoadStore)
		)
	}
}


Uniforms :: struct {
	objectToCamera: mat4
	projection: mat4
}

ocean : struct {
	device: cu.Device
	module: cu.Module
	initializeSpectrum: cu.Kernel
	updateSpectrum: cu.Kernel
	horizontalFft: cu.Kernel
	verticalFft: cu.Kernel
	assembleMaps: cu.Kernel
	params: kernels.OceanParams
	initial: CudaTexture
	horizontalDisplacement: CudaTexture
	spectrumB: CudaTexture
	spectrumC: CudaTexture
	spectrumD: CudaTexture
	displacementFoam: CudaTexture
	slope: CudaTexture
	moduleLoaded: bool
	initialized: bool
	gpuParams: cu.DevicePointer
} = (
	params = (
		resolution = @numCast(OceanResolution, u32),
		lengthScale = 128,
		frameTime = 0,
		deltaTime = 0,
		repeatTime = 200,
		depth = 200,
		lowCutoff = 0.001,
		highCutoff = 1000,
		seed = 1,
		jonswap = (
			scale = 1,
			angle = 0,
			spreadBlend = 0.7,
			swell = 0.5,
			alpha = 0.0081,
			peakOmega = 0.8,
			gamma = 3.3,
			shortWavesFade = 0.08,
		),
		lambda = (.7, .7),
		foamBias = -.9,
		foamDecayRate = 0.4,
		foamAdd = 0.5,
		foamThreshold = 0.1,
	)
)

Surfaces :: struct {
	initial: cu.Surface
	horizontalDisplacement: cu.Surface
	spectrumB: cu.Surface
	spectrumC: cu.Surface
	spectrumD: cu.Surface
	displacementFoam: cu.Surface
	slope: cu.Surface
}

SurfacesMethods :: Surfaces impl {
	map :: fn() -> Self {
		return (
			initial = ocean.initial.resource.mapSurface(),
			horizontalDisplacement = ocean.horizontalDisplacement.resource.mapSurface(),
			spectrumB = ocean.spectrumB.resource.mapSurface(),
			spectrumC = ocean.spectrumC.resource.mapSurface(),
			spectrumD = ocean.spectrumD.resource.mapSurface(),
			displacementFoam = ocean.displacementFoam.resource.mapSurface(),
			slope = ocean.slope.resource.mapSurface(),
		)
	}

	unmap :: fn(self: ^Self) {
		self.initial.destroy()
		self.horizontalDisplacement.destroy()
		self.spectrumB.destroy()
		self.spectrumC.destroy()
		self.spectrumD.destroy()
		self.displacementFoam.destroy()
		self.slope.destroy()
		ocean.initial.resource.unmap()
		ocean.horizontalDisplacement.resource.unmap()
		ocean.spectrumB.resource.unmap()
		ocean.spectrumC.resource.unmap()
		ocean.spectrumD.resource.unmap()
		ocean.displacementFoam.resource.unmap()
		ocean.slope.resource.unmap()
	}
}

startupFrameLogged := false

startupLog :: fn(message: []u8) {
	print("[startup] ")
	println(message)
}

startupValue :: fn(label: []u8, value: s32) {
	print("[startup] ")
	print(label)
	print(": ")
	print_s32(value)
	println("")
}

oceanGrid :: fn() -> cu.Grid {
	return (
		OceanResolution / OceanBlockSize,
		OceanResolution / OceanBlockSize,
		1,
	)
}

oceanBlock :: fn() -> cu.Block {
	return (OceanBlockSize, OceanBlockSize, 1)
}

setupOceanTextures :: fn() {
	ocean.initial = CudaTextureMethods.create()
	ocean.horizontalDisplacement = CudaTextureMethods.create()
	ocean.spectrumB = CudaTextureMethods.create()
	ocean.spectrumC = CudaTextureMethods.create()
	ocean.spectrumD = CudaTextureMethods.create()
	ocean.displacementFoam = CudaTextureMethods.createRgba()
	ocean.slope = CudaTextureMethods.create()
	sg.reset_state_cache()
	imageDesc := sg.image_desc(
		usage = (immutable = true),
		width = OceanResolution,
		height = OceanResolution,
		num_slices = 1,
		num_mipmaps = 1,
		pixel_format = .RGBA32F,
		sample_count = 1,
		gl_textures = [ocean.displacementFoam.texture.id, 0],
		gl_texture_target = cu.GlTexture2d,
		label = c"ocean-image"
	)
	state.oceanImage = sg.make_image(^imageDesc)
	print("Ocean image state: ")
	sg.query_image_state(state.oceanImage).print()
	println("")
	viewDesc := sg.view_desc(texture = (image = state.oceanImage), label = c"ocean-view")
	println("Make view")
	state.oceanView = sg.make_view(^viewDesc)
	print("Ocean view state: ")
	sg.query_view_state(state.oceanView).print()
	println("")
	println("Make sampler")
	samplerDesc := sg.sampler_desc(
		min_filter = .NEAREST,
		mag_filter = .NEAREST,
		mipmap_filter = .NEAREST,
		label = c"ocean-sampler"
	)
	state.oceanSampler = sg.make_sampler(^samplerDesc)
	state.bind.views[0] = state.oceanView
	state.bind.samplers[0] = state.oceanSampler

}

initSpectrum :: fn() {
	startupLog("launch initializeSpectrum")
	surfaces := SurfacesMethods.map()
	args := [
		^surfaces.initial,
	]^void
	ocean.gpuParams.upload(^ocean.params, @sizeOf @type ocean.params)
	fmt.print("Surface id: ")
	fmt.print_s32(@numCast(surfaces.initial.id))
	fmt.println("")
	startupLog("arged")
	ocean.initializeSpectrum.launch(args[^], oceanGrid(), oceanBlock(), 0)
	startupLog("launched")
	cu.sync().log()
	startupLog("synced")
	surfaces.unmap()
	ocean.initialized = true
	startupLog("cuda setup complete")
}

# CUDA-GL interop requires a CUDA context before registering GL textures.
# The GL context already exists when Sokol invokes init.
setupCudaModule :: fn() {
	if (ocean.moduleLoaded) {
		return
	}
	startupLog("cuda module init")
	ocean.module = ocean.device.init(@cudaPtx kernels)
	startupLog("cuda module loaded")
	startupLog("load kernel initializeSpectrum")
	ocean.initializeSpectrum = ocean.module.loadKernel(kernels.initializeSpectrum)
	ocean.updateSpectrum     = ocean.module.loadKernel(kernels.updateSpectrum)
	ocean.horizontalFft      = ocean.module.loadKernel(kernels.horizontalFft)
	ocean.verticalFft        = ocean.module.loadKernel(kernels.verticalFft)
	ocean.assembleMaps       = ocean.module.loadKernel(kernels.assembleMaps)
	ocean.moduleLoaded       = true
	ocean.gpuParams          = ocean.module.getGlobal(kernels.params)
	startupLog("cuda kernels loaded")
}

updateOcean :: fn(frameTime: f32, dt: f32) {
	ocean.params.frameTime = frameTime
	ocean.params.deltaTime = dt
	ocean.gpuParams.upload(^ocean.params, @sizeOf @type ocean.params)
	surfaces := SurfacesMethods.map()

	updateArgs := [
		^surfaces.initial,
		^surfaces.horizontalDisplacement,
		^surfaces.spectrumB,
		^surfaces.spectrumC,
		^surfaces.spectrumD,
	]^void
	ocean.updateSpectrum.launch(updateArgs[^], oceanGrid(), oceanBlock(), 0)
	fftArgs := [
		^surfaces.horizontalDisplacement,
		^surfaces.spectrumB,
		^surfaces.spectrumC,
		^surfaces.spectrumD,
	]^void
	ocean.horizontalFft.launch(fftArgs[^], (1, OceanResolution, 1), (OceanResolution, 1, 1), 0)
	ocean.verticalFft.launch(fftArgs[^], (OceanResolution, 1, 1), (OceanResolution, 1, 1), 0)
	assembleArgs := [
		^surfaces.horizontalDisplacement,
		^surfaces.spectrumB,
		^surfaces.spectrumC,
		^surfaces.spectrumD,
		^surfaces.displacementFoam,
		^surfaces.slope,
	]^void
	ocean.assembleMaps.launch(assembleArgs[^], oceanGrid(), oceanBlock(), 0)
	cu.sync().log()
	surfaces.unmap()
}

SgResourceStateMethods :: sg.resource_state impl {
	print :: fn(self: Self) {
		print(@name(self))
	}
}

state : struct {
    pip: sg.pipeline
	skyPipeline: sg.pipeline
    bind: sg.bindings
    passAction: sg.pass_action
	oceanImage: sg.image
	oceanView: sg.view
	oceanSampler: sg.sampler
	testTexture: gl.Texture2d
	position: vec3
	latitude: f32
	longitude: f32
	bg: microui.Color
} = (position = (0, 4, 2), bg = (a = 255))

Input :: struct {
	mousePos: vec2
	mouseDown: bool
	forward: bool
	backward: bool
	left: bool
	right: bool
	up: bool
	down: bool
	mouseDelta: vec2
	scroll: f32
}

input: Input

InputMethods :: Input impl {
	press :: fn(self: ^Self, keycode: app.keycode, pressed: bool) {
		when (keycode) {
			.W -> input.forward
			.A -> input.left
			.S -> input.backward
			.D -> input.right
			.SPACE -> input.up
			.LEFT_SHIFT -> input.down
			.RIGHT_SHIFT -> input.down
			else -> return
		} = pressed
	}
}

cleanup :: fn() {
	sg.shutdown()
}

startTime : u64 = 0

PlaneRes :: 256
PlaneFence :: PlaneRes - 1
indexLength :: 6 (PlaneFence ** 2)

FileModule :: import "file.blub"
File :: FileModule.File
FileMethods :: FileModule.FileMethods
Shader :: struct {
	vs: File
	fs: File

}

ShaderMethods :: Shader impl {
	load :: fn(vertPath: ^u8, fragPath: ^u8) -> Self {
		return (
			FileMethods.read(vertPath, true),
			FileMethods.read(fragPath, true)
		)
	}

	create :: fn(self: ^Self, desc: sg.shader_desc) -> sg.shader {
		shader := sg.shader_desc(
			vertex_func = (
				source = vs.contents.data,
				entry = c"main",
			),
			fragment_func = (
				source = fs.contents.data,
				entry = c"main",
			),
			label = c"triangle_shader"
		)		
		return sg.make_shader(^shader)
		# fullShader := 
		# println("Made shader")
		# # fs.close()
		# # vs.close()
		# return fullShader
	}
}

init :: fn() {
	startupLog("init begin")
	desc := sg.desc(
		environment = sokol.glue.environment(),
		logger = (func = sokol.log.func)
	)
	startupLog("calling sg.setup")
	sg.setup(^desc)
	startupLog("sg.setup complete")
	gl.logDriver()
	time.setup()

	# R R+1
	#  \
	# 0 1
	vertIndex :: fn(x: u32, y: u32) -> u32 {
		return x PlaneRes + y
	}

	using import "memory.blub"
	Verts :: [PlaneRes ** 2]vec2
	verts : ^Verts = malloc @sizeOf Verts
	Indices :: [indexLength]u32
	indices : ^Indices = malloc @sizeOf Indices
	for (x: u32 = 0..<PlaneRes) for (y: u32 = 0..<PlaneRes) {
		i := (x PlaneRes) + y
		verts^[i] = (@numCast(x, f32) / PlaneFence, @numCast(y, f32) / PlaneFence)
	}

	for (x: u32 = 0 ..< PlaneFence) for (y: u32 = 0 ..< PlaneFence) {
	  triIndex := 6 ((x PlaneFence) + y)
	  vert := vertIndex(x, y)
	  indices^[triIndex]     = vert
	  indices^[triIndex + 1] = vert + PlaneRes
	  indices^[triIndex + 2] = vert + 1

	  indices^[triIndex + 3] = vert + PlaneRes
	  indices^[triIndex + 4] = vert + PlaneRes + 1
	  indices^[triIndex + 5] = vert + 1
	}

	println "finished geometry init"

	vertBufferDesc := sg.buffer_desc(
		data = sg.range(verts, @sizeOf Verts),
		label = c"vertex-buf",
	)

	indexBufferDesc := sg.buffer_desc(
		data = sg.range(indices, @sizeOf Indices),
		usage = (index_buffer = true),
		label = c"index-buf",
	)

	vertBuffer := sg.make_buffer(^vertBufferDesc)
	indexBuffer := sg.make_buffer(^indexBufferDesc)
	startupLog("buffers created")
	state.bind.vertex_buffers[0] = vertBuffer
	print("Vertex buffer state: ")
	sg.query_buffer_state(vertBuffer).print()
	println("")

	state.bind.index_buffer = indexBuffer

	{
		println "Making ocean pipeline"
		oceanShader := ShaderMethods.load(c"ocean.vert", c"ocean.frag", (
			attrs = [(base_type = .FLOAT, glsl_name = c"position")],
			views = [(texture=(stage = .FRAGMENT, sample_type = .UNFILTERABLE_FLOAT))],
			samplers = [(stage = .FRAGMENT, sampler_type = .NONFILTERING)],
			texture_sampler_pairs = [(stage = .FRAGMENT, view_slot = 0, sampler_slot=0, glsl_name = c"ocean_tex")],
			uniform_blocks = [(
					stage = .VERTEX,
					size = @sizeOf mat4,
					glsl_uniforms = [(
					    type = .FLOAT4,
					    array_count = 4,
					    glsl_name = c"mvp"
					), (
						type = .FLOAT4,
						array_count = 4,
						glsl_name = c"proj"
					)]
				), (stage = .FRAG, size = @sizeOf mat4)]
		))

		pipelineDesc := sg.pipeline_desc(
			shader = oceanShader,
			cull_mode = .BACK,
			depth = (
				write_enabled = true,
				compare = .LESS_EQUAL,
			),
			index_type = .UINT32,
		)
		print("Shader creation: ")
		sg.query_shader_state(pipelineDesc.shader).print()
		println("")

		pipelineDesc.layout.attrs[0].format = .FLOAT2

		startupLog("creating pipeline")
		state.pip = sg.make_pipeline(^pipelineDesc)
		if (state.pip.id == 0) {
			print("Failed to make pipeline")
		} else {
			print("Made pipeline")
		}
		println("")
		print("Pipeline creation: ")
		sg.query_pipeline_state(state.pip).print()
		println("")
	}

	{
		
	}

	state.passAction.colors[0] = (
		load_action = .CLEAR,
		clear_value = (0, 0, 0, 1)
	)

	startupLog("starting cuda setup")
	setupCudaModule()
	startupLog("creating ocean texture")
	setupOceanTextures()
	initSpectrum()
	ui = microui.ContextMethods.create()
	startupLog "UI creation finished"
}

ui: ^microui.Context

prevTime := 0.
deltaTime := 0.

frame :: fn() {
	if (!startupFrameLogged) {
		startupLog("first frame begin")
	}

	ui.begin()
	ui.beginWindow(c"Simulation Params", (0, 0, 300, 240))

	if (ui.headerEx(c"Background Color", .Expanded)) {
		cols := [-78, -1]
		ui.layoutRow(2, cols[^], 74)

		ui.layoutBeginColumn()
		{
			cols = [46, -1]
		    ui.layoutRow(2, cols[^], 0)

			ui.label(c"Red:")
			ui.sliderU8(^state.bg.r)

		    ui.label(c"Green:")
			ui.sliderU8(^state.bg.g)

		    ui.label(c"Blue:")
			ui.sliderU8(^state.bg.b)
		}
		ui.layoutEndColumn()

		# Color preview
		rect := ui.layoutNext()
		ui.drawRect(rect, state.bg)
	}

	if (ui.headerEx(c"Spectrum Params", .Expanded)) {
		changed := false
		ui.layoutBeginColumn()
		{
			cols := [78, -1]
			ui.layoutRow(2, cols[^], 0)

			jonswap := ^ocean.params.jonswap
			ui.label(c"Scale")
			result := ui.slider(^jonswap.scale, 0, 1)
			ui.label(c"Wind Angle (turn)")
			# TODO: angle / 2 pi => angle / (2 pi) vs (angle / 2) pi
			angle := ocean.params.jonswap.angle / (2pi)
			angleChanged := ui.slider(^angle, 0, 1)
			if (angleChanged) {
				ocean.params.jonswap.angle = 2angle pi
			}
			result |= angleChanged
			ui.label(c"spreadBlend")
			result |= ui.slider(^jonswap.spreadBlend, 0, 1)
			ui.label(c"swell")
			result |= ui.slider(^jonswap.swell, 0, 1)
			ui.label(c"Alpha")
			result |= ui.slider(^jonswap.alpha, 0, 1)
			ui.label(c"Peak Omega")
			result |= ui.slider(^jonswap.peakOmega, 0, 1)
			ui.label(c"gamma")
			result |= ui.slider(^jonswap.gamma, 0, 7)
			ui.label(c"Short Waves Fade")
			result |= ui.slider(^jonswap.shortWavesFade, 0, 1)

			if (result & .Change) {
				initSpectrum()
			}
		}
		ui.layoutEndColumn()
	}

	ui.endWindow()
	ui.end()

	seconds : f32 = @numCast(time.sec(time.since(startTime)))
	deltaTime = seconds - prevTime
	movement := vec3(
		if (input.left) -1 else if (input.right) 1 else 0,
		if (input.up) 1 else if (input.down) -1 else 0,
		# TODO: fix integer constants
		input.scroll + if (input.backward) 1 else if (input.forward) -1 else 0
	) 100
	input.scroll = 0

	updateOcean(seconds, deltaTime)
	if (!startupFrameLogged) {
		startupLog("first frame cuda launches complete")
		startupFrameLogged = true
	}

	# colors
	state.passAction.colors[0].clear_value = state.bg.toFloat()

	# rendering
	pass := sg.pass(action = state.passAction, swapchain = sokol.glue.swapchain())
	sg.begin_pass(^pass)
	sg.apply_pipeline(state.pip)
	sg.apply_bindings(^state.bind)

	# camera
	w := app.widthf()
	h := app.heightf()
	aspect := w/h
	rotation := quatMethods.geographic(state.latitude, state.longitude)

	# controls
	translationAmount := RotateV3Q(movement, rotation.inverse())
	translationAmount = MulV3F(translationAmount, deltaTime)
	state.position = AddV3(state.position, translationAmount)

	orientation := quatMethods.geographic(state.latitude, state.longitude)

	uniforms := Uniforms(
		objectToCamera = orientation.inverse().toMatrix() Translate(MulV3F(state.position, -1)),
		proj = Perspective(1. / 6., aspect, 0.01, 1000)
	)

	uniformRange := sg.range(^mvp, @sizeOf @type(mvp))
	sg.apply_uniforms(0, ^uniformRange)

	sg.draw(0, indexLength, 1)
	ui.render(w, h)
	sg.end_pass()
	sg.commit()

	prevTime = seconds
}

event :: fn(e: ^app.event) {
	when (e.type) {
		.MOUSE_DOWN -> {
			println("mouse down")
		    ui.inputMouseDown(
				@numCast(e.mouse_x),
				@numCast(e.mouse_y),
				1 << @raw e.mouse_button
			)
			if (!ui.mouseCaptured()) input.mouseDown = true
		}
		.MOUSE_UP -> {
			println("mouse up")
		    ui.inputMouseUp(
				@numCast(e.mouse_x),
				@numCast(e.mouse_y),
				1 << @raw e.mouse_button
			)
			input.mouseDown = false
		}
		.KEY_DOWN -> input.press(e.key_code, true)
		.KEY_UP -> input.press(e.key_code, false)
		.MOUSE_MOVE -> {
			ui.inputMouseMove(@numCast(e.mouse_x), @numCast(e.mouse_y))
			if (input.mouseDown) {
				dt := .2deltaTime
				state.latitude += e.mouse_dx dt
				state.longitude += e.mouse_dy dt
			}
		}
		.MOUSE_SCROLL -> {
			ui.inputScroll(@numCast(-30 e.scroll_x), @numCast(-30 e.scroll_y))
			if (!ui.mouseCaptured()) {
				input.scroll += -e.scroll_y
			}
		}
	}
}

sokol_main :: fn(argc: s32, argv: [^][^]u8) -> app.desc {
	return (
		init_cb = init,
		frame_cb = frame,
		cleanup_cb = cleanup,
		event_cb = event,
		width = 640,
		height = 480,
		window_title = c"Triangle",
	)
}
