using import "math.cu.blub"
using import "builtins.cu.blub"

Size :: 256
gravity :: 9.81

Jonswap :: struct {
	scale: f32
	angle: f32
	spreadBlend: f32
	swell: f32
	alpha: f32
	peakOmega: f32
	gamma: f32
	shortWavesFade: f32
}

OceanParams :: struct {
	resolution: u32
	lengthScale: f32
	frameTime: f32
	deltaTime: f32
	repeatTime: f32
	depth: f32
	lowCutoff: f32
	highCutoff: f32
	seed: u32
	jonswap: Jonswap
	lambda: vec2
	foamBias: f32
	foamDecayRate: f32
	foamAdd: f32
	foamThreshold: f32
}

@shared fftBuffer : [2][256]complex
barrier :: fn "llvm.nvvm.barrier0"()

dispersion :: fn(params: OceanParams, k: f32) -> f32 {
	return sqrt(gravity * k * tanh(min(k * params.depth, 20)))
}

dispersionDerivative :: fn(params: OceanParams, k: f32) -> f32 {
	th := tanh(min(k * params.depth, 20))
	ch := cosh(k * params.depth)
	return gravity * (params.depth * k / ch / ch + th) / dispersion(params, k) / 2
}

normalizationFactor :: fn(s: f32) -> f32 {
	s2 := s * s
	s3 := s2 * s
	s4 := s3 * s
	return if (s < 5) -0.000564 * s4 + 0.00776 * s3 - 0.044 * s2 + 0.192 * s + 0.163
		else -4.80e-08 * s4 + 1.07e-05 * s3 - 9.53e-04 * s2 + 5.90e-02 * s + 0.393
}

cosine2s :: fn(theta: f32, s: f32) -> f32 {
	return normalizationFactor(s) * pow(abs(cos(0.5 * theta)), 2 * s)
}

spreadPower :: fn(omega: f32, peakOmega: f32) -> f32 {
	ratio := abs(omega / peakOmega)
	return if (omega > peakOmega) 9.77 * pow(ratio, -2.5) else 6.97 * pow(ratio, 5)
}

directionSpectrum :: fn(params: OceanParams, theta: f32, omega: f32) -> f32 {
	spectrum := params.jonswap
	s := spreadPower(omega, spectrum.peakOmega) + 16 * tanh(min(omega / spectrum.peakOmega, 20)) * spectrum.swell * spectrum.swell
	a := 2 / pi * cos(theta) * cos(theta)
	b := cosine2s(theta - spectrum.angle, s)
	return lerp(a, b, spectrum.spreadBlend)
}

tmaCorrection :: fn(params: OceanParams, omega: f32) -> f32 {
	omegaH := omega * sqrt(params.depth / gravity)
	return if (omegaH <= 1) 0.5 * omegaH * omegaH
		else if (omegaH < 2) 1 - 0.5 * (2 - omegaH) * (2 - omegaH)
		else 1
}

jonswapSpectrum :: fn(params: OceanParams, omega: f32) -> f32 {
	spectrum := params.jonswap
	sigma := if (omega <= spectrum.peakOmega) 0.07 else 0.09
	difference := omega - spectrum.peakOmega
	r := exp(-difference * difference / 2 / sigma / sigma / spectrum.peakOmega / spectrum.peakOmega)
	oneOverOmega := 1 / omega
	peakRatio := spectrum.peakOmega / omega
	omegaPower := oneOverOmega * oneOverOmega * oneOverOmega * oneOverOmega * oneOverOmega
	peakShape := exp(-1.25 * peakRatio * peakRatio * peakRatio * peakRatio)
	return spectrum.scale * tmaCorrection(params, omega) * spectrum.alpha * gravity * gravity * omegaPower * peakShape * pow(abs(spectrum.gamma), r)
}

shortWaveFade :: fn(params: OceanParams, k: f32) -> f32 {
	fade := params.jonswap.shortWavesFade
	return exp(-fade * fade * k * k)
}

dispatchCoord :: fn() -> PixelCoord {
	return (
		@blockIdxX * @blockDimX + @threadIdxX,
		@blockIdxY * @blockDimY + @threadIdxY,
	)
}

initializeSpectrum :: kernel(
	params: OceanParams,
	initial: Surface,
) {
	coord := dispatchCoord()
	if (coord.x >= params.resolution or coord.y >= params.resolution) {
		return
	}
	halfN := @numCast(params.resolution, f32) * 0.5
	deltaK := tau / params.lengthScale
	k := vec2(
		(@numCast(coord.x, f32) - halfN) * deltaK,
		(@numCast(coord.y, f32) - halfN) * deltaK,
	)
	kLength := k.length()
	value := vec2(0, 0)
	if (params.lowCutoff <= kLength) {
		if (kLength <= params.highCutoff) {
			seed := coord.x + params.resolution * coord.y + params.resolution + params.seed
			gauss1 := gaussianPair(seed)
			gauss2 := gaussianPair(seed + 2)
			omega := dispersion(params, kLength)
			dOmegaDk := dispersionDerivative(params, kLength)
			energy := jonswapSpectrum(params, omega) * directionSpectrum(params, atan2(k.y, k.x), omega) * shortWaveFade(params, kLength)
			amplitude := sqrt(2 * energy * abs(dOmegaDk) / kLength * deltaK * deltaK)
			value = (gauss2.x * amplitude, gauss1.y * amplitude)
		}
	}
	initial.writeVec2(coord, value)
}

updateSpectrum :: kernel(
	params: OceanParams,
	initial: Surface,
	spectrumA: Surface,
	spectrumB: Surface,
	spectrumC: Surface,
	spectrumD: Surface,
) {
	coord := dispatchCoord()
	if (coord.x >= params.resolution or coord.y >= params.resolution) {
		return
	}
	mirror := PixelCoord((params.resolution - coord.x) % params.resolution, (params.resolution - coord.y) % params.resolution)
	h0 := initial.readComplex(coord)
	h0Conjugate := initial.readComplex(mirror).conjugate()
	halfN := @numCast(params.resolution, f32) 0.5
	deltaK := tau / params.lengthScale
	k := vec2((@numCast(coord.x, f32) - halfN) * deltaK, (@numCast(coord.y, f32) - halfN) * deltaK)
	kMagnitude := k.length()
	kReciprocal := if (kMagnitude < 0.0001) 1 else 1 / kMagnitude
	w0 := tau / params.repeatTime
	phase := floor(sqrt(gravity * kMagnitude) / w0) * w0 * params.frameTime
	exponent := complex.exp(phase)
	hTilde := h0 exponent + h0Conjugate exponent.conjugate()
	ih := hTilde.timesI()
	displacementX := ih.scale(k.x * kReciprocal)
	displacementY := hTilde
	displacementZ := ih.scale(k.y * kReciprocal)
	displacementXdx := hTilde.scale(-k.x * k.x * kReciprocal)
	displacementYdx := ih.scale(k.x)
	displacementZdx := hTilde.scale(-k.x * k.y * kReciprocal)
	displacementYdz := ih.scale(k.y)
	displacementZdz := hTilde.scale(-k.y * k.y * kReciprocal)
	spectrumA.writeVec2(coord, (displacementX.re - displacementZ.im, displacementX.im + displacementZ.re))
	spectrumB.writeVec2(coord, (displacementY.re - displacementZdx.im, displacementY.im + displacementZdx.re))
	spectrumC.writeVec2(coord, (displacementYdx.re - displacementYdz.im, displacementYdx.im + displacementYdz.re))
	spectrumD.writeVec2(coord, (displacementXdx.re - displacementZdz.im, displacementXdx.im + displacementZdz.re))
}

butterflyStep :: fn(step: u32, index: u32) {
	b := Size >> (step + 1)
	w := b * (index / b)
	i := (w + index) % Size
	source := step & 1
	destination := source ~ 1
	twiddle := complex.exp(tau * @numCast(w, f32) / @numCast(Size, f32))
	fftBuffer[destination][index] = fftBuffer[source][i] + twiddle fftBuffer[source][i + b]
}

fftSurface :: fn(surface: Surface, horizontal: bool) {
	index := @threadIdxX
	coord := if (horizontal) PixelCoord(index, @blockIdxY) else PixelCoord(@blockIdxX, index)

	fftBuffer[0][index] = surface.readComplex(coord)
	barrier()

	stride : u32 = Size
	step : u32 = 0
	while (stride > 1) {
		butterflyStep(step, index)
		barrier()

		stride = stride >> 1
		step += 1
	}
	surface.writeComplex(coord, fftBuffer[0][index])
	barrier()
}

horizontalFft :: kernel(a: Surface, b: Surface, c: Surface, d: Surface) {
	fftSurface(a, true)
	fftSurface(b, true)
	fftSurface(c, true)
	fftSurface(d, true)
}

verticalFft :: kernel(a: Surface, b: Surface, c: Surface, d: Surface) {
	fftSurface(a, false)
	fftSurface(b, false)
	fftSurface(c, false)
	fftSurface(d, false)
}

clamp01 :: fn(value: f32) -> f32 {
	return min(max(value, 0), 1)
}

assembleMaps :: kernel(
	params: OceanParams,
	spectrumA: Surface,
	spectrumB: Surface,
	spectrumC: Surface,
	spectrumD: Surface,
	displacementOut: Surface,
	slopeOut: Surface,
) {
	coord := dispatchCoord()
	if (coord.x >= params.resolution or coord.y >= params.resolution) {
		return
	}
	sign : f32 = if ((coord.x + coord.y) % 2 == 0) 1 else -1
	dxdz := spectrumA.readVec2(coord).scale sign
	dydxz := spectrumB.readVec2(coord).scale sign
	dyxdyz := spectrumC.readVec2(coord).scale sign
	dxxdzz := spectrumD.readVec2(coord).scale sign
	jacobian := (1 + params.lambda.x * dxxdzz.x) * (1 + params.lambda.y * dxxdzz.y) - params.lambda.x * params.lambda.y * dydxz.y * dydxz.y
	previousFoam := displacementOut.readVec4(coord).w
	foam := previousFoam * exp(-params.foamDecayRate params.deltaTime)
	foamSource := clamp01((params.foamThreshold - (jacobian + params.foamBias)) * params.foamAdd)
	foam = clamp01(foam + foamSource)
	displacementOut.writeVec4(coord, (params.lambda.x * dxdz.x, params.lambda.y * dxdz.y, dydxz.x, foam))
	slopeX := dyxdyz.x / max(0.001, 1 + params.lambda.x * dxxdzz.x)
	slopeZ := dyxdyz.y / max(0.001, 1 + params.lambda.y * dxxdzz.y)
	slopeOut.writeVec2(coord, (slopeX, slopeZ))
}
